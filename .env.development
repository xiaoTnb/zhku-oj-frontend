# 本地开发环境全局变量配置

# API服务器基地址
VITE_API_BASE_URL=/api/v1

# 服务器主机地址
VITE_SERVER_HOST=http://118.195.215.81

# 开发环境代理前缀（部署在 /oj 子路径时设置为 /oj）
VITE_API_PROXY_PREFIX=/oj

# WebSocket服务器基地址
VITE_WS_BASE_URL=ws://118.195.215.81/oj/api/v1

# 开发服务器端口
VITE_DEV_PORT=25173

# 1、axios请求基地址为 /api/v1 （开发环境变量 VITE_API_BASE_URL 设置）
# 2、vite代理将 /api/v1 重定向到 VITE_SERVER_HOST（开发环境变量 VITE_SERVER_HOST 设置）

