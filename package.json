    "monaco-editor": "0.53.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "vue3-qrcode-reader": "^0.0.1"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
